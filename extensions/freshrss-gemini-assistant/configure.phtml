<?php
  $conf = FreshRSS_Context::$user_conf;
  $gemini_api_key = $conf->gemini_api_key ?? '';
  $gemini_model = $conf->gemini_model ?? 'gemini-3-flash-preview';
  $gemini_thinking_level = $conf->gemini_thinking_level ?? 'LOW';
  $gemini_summary_prompt = $conf->gemini_summary_prompt ?? '';
  $gemini_custom_css = $conf->gemini_custom_css ?? '';
  function printThinkingOption($level, $selected) {
    echo '<option ' . ($selected == $level ? 'selected ' : '') . 'value="' . $level . '">' . $level . '</option>';
  }
?>

